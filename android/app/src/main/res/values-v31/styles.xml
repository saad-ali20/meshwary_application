<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) native platform SplashScreen configuration.
  The Android OS automatically reads windowSplashScreenBackground and
  windowSplashScreenAnimatedIcon during cold boot.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/meshwary_logo</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>
</resources>

